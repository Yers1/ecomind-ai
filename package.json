    "test:backend": "node scripts/test-backend-contract.mjs",
    "test:supabase:local": "node scripts/test-supabase-local.mjs",
    "test:supabase:live": "node scripts/test-supabase-live.mjs",
    "test:engagement": "node scripts/test-engagement.mjs",
    "test:parsers": "node scripts/test-parsers.mjs",
    "test:extension": "npm run build:extension && node scripts/test-extension.mjs",
