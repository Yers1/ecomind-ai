# Public browser configuration. Safe to expose only because database access is protected by RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Set to true only after migrations and the documented three-account/RLS checks pass.
VITE_SUPABASE_LIVE_VERIFIED=false

# Optional live-test accounts. Never commit real values; use a local .env.test.local file.
SUPABASE_TEST_ACCOUNT_A_EMAIL=
SUPABASE_TEST_ACCOUNT_A_PASSWORD=
SUPABASE_TEST_ACCOUNT_B_EMAIL=
SUPABASE_TEST_ACCOUNT_B_PASSWORD=
SUPABASE_TEST_ACCOUNT_C_EMAIL=
SUPABASE_TEST_ACCOUNT_C_PASSWORD=
